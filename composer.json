{
    "name": "fisal/laravel-otp",
    "type": "library",
    "license": "MIT",
    "authors": [
        {
            "name": "Michael Okoh",
            "email": "michael@okoh.co.uk"
        }
    ],
    "minimum-stability": "stable",
    "autoload": {
        "psr-4": {
            "Fisal\\Otp\\": "src/"
        }
    },
    "extra": {
        "laravel": {
            "providers": [
                "Fisal\\Otp\\OtpServiceProvider"
            ],
            "aliases": {
                "Otp": "Fisal\\Otp\\Otp"
            }
        }
    },
    "require": {
        "php": "^8.1|^8.2|^8.3|^8.4",
        "illuminate/support": "^9.0|^10.0|^11.0",
        "illuminate/database": "^9.0|^10.0|^11.0",
        "nesbot/carbon": "^2.0|^3.0"
    },
    "description": "A simple package to generate and validate OTPs (internal fork with improvements)",
    "require-dev": {
        "orchestra/testbench": "^7.0|^8.0|^9.0",
        "phpunit/phpunit": "^9.6|^10.0"
    },
    "prefer-stable": true,
    "autoload-dev": {
        "psr-4": {
            "Fisal\\Otp\\Tests\\": "tests/"
        }
    }
}