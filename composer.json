{
  "name": "fisal/laravel-otp",
  "description": "Laravel OTP package with OTP type binding and attempts limiting.",
  "type": "library",
  "license": "MIT",
  "keywords": ["laravel", "otp", "2fa", "2factor", "verification", "one-time-password"],
  "homepage": "https://mohamed-fisal.com/",
  "authors": [
    {
      "name": "Mohamed Fisal",
      "email": "fisalmhmd56@gmail.com",
      "homepage": "https://mohamed-fisal.com/",
      "role": "Maintainer"
    }
  ],
  "support": {
    "issues": "https://github.com/muuFisal/fisal-laravel-otp/issues",
    "source": "https://github.com/muuFisal/fisal-laravel-otp"
  },
  "autoload": {
    "psr-4": {
      "Fisal\\Otp\\": "src/"
    }
  },
  "autoload-dev": {
    "psr-4": {
      "Fisal\\Otp\\Tests\\": "tests/"
    }
  },
  "extra": {
    "laravel": {
      "providers": [
        "Fisal\\Otp\\OtpServiceProvider"
      ],
      "aliases": {
        "Otp": "Fisal\\Otp\\Otp"
      }
    },
    "branch-alias": {
      "dev-main": "1.x-dev"
    }
  },
  "require": {
    "php": "^8.1|^8.2|^8.3|^8.4",
    "illuminate/support": "^9.0|^10.0|^11.0",
    "illuminate/database": "^9.0|^10.0|^11.0",
    "nesbot/carbon": "^2.0|^3.0"
  },
  "require-dev": {
    "orchestra/testbench": "^7.0|^8.0|^9.0",
    "phpunit/phpunit": "^9.6|^10.0|^11.0"
  },
  "prefer-stable": true
}
